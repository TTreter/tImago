{
  "name": "timago",
  "productName": "tImago",
  "version": "1.5.0",
  "description": "tImago — Sistema de Controle de Overlay em Tempo Real para OBS Studio",
  "main": "electron-main.js",
  "author": "Tiago Treter (TTreter)",
  "license": "MIT",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "build:exe": "electron-builder --win portable nsis"
  },
  "dependencies": {
    "express": "^4.19.2",
    "multicast-dns": "^7.2.5",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "electron": "^31.4.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.ttreter.timago",
    "productName": "tImago",
    "files": [
      "electron-main.js",
      "server.js",
      "updater-service.js",
      "mdns-service.js",
      "public/**/*",
      "data/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "public/img/icon.png",
      "signAndEditExecutable": false
    },
    "portable": {
      "unpackDirName": "tImago-App",
      "useZip": true,
      "artifactName": "tImago-Portable-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "tImago",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "artifactName": "tImago-Setup-${version}.exe"
    }
  }
}
