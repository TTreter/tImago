{
  "name": "timago",
  "productName": "tImago",
  "version": "1.0.2",
  "description": "tImago — Sistema de Controle de Overlay em Tempo Real para OBS Studio",
  "main": "electron-main.js",
  "author": "Tiago Treter (TTreter)",
  "license": "MIT",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "build:exe": "electron-builder --win portable"
  },
  "dependencies": {
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "electron": "^31.4.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.ttreter.timago",
    "productName": "tImago",
    "files": [
      "electron-main.js",
      "server.js",
      "public/**/*",
      "data/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "public/img/icon.png",
      "signAndEditExecutable": false,
      "artifactName": "tImago-Portable-${version}.exe"
    }
  }
}
